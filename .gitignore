# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# 設定檔（含真實帳密；多環境全部 gitignore，只有 example 進版控）
config/config.local.yaml
config/config.dev.yaml
config/config.test.yaml
config/config.prod.yaml

# 登入態（含 cookies/storageState）
.auth/
!.auth/.keep

# 測試報告與附件（POC 階段先不進 git；穩定後再決定）
reports/
!reports/.keep

# Playwright
playwright-report/
test-results/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# 前端原始碼（僅作 read-only 參考，不該 vendored）
src/
!src/.keep

# 暫存檔
.tmp_*
/tmp*.txt
/*_out.txt
/scratch_*

# 壓測憑證（真實 JWT，不入版控）
壓測腳本_JMeter/shared/token.txt
壓測腳本_JMeter/shared/tokens.csv

# Debug 產出物
debug_filter.png
debug_*.png

# 一次性診斷產物（正式探測工具為 tools/dom_probe.py；歷史 diag 腳本歸檔於 _archive）
tools/_diag_*
tools/_tmp_*
tools/_session*.html
tools/_archive/

# 第三方業務文件（PDF；公開 repo 不帶，本機保留）
*.pdf

# 個人進度狀態（Golden 個人筆記，不入團隊共享）
# 若改為團隊共享：移除此行並 git add -f STATUS.md
STATUS.md

# =============================================
# 專案成果目錄 — 屬公司版控（aiautotest），不入個人版控
# 個人版控只存框架與工程經驗；專案產出透過 sync_to_company.ps1 同步
# =============================================
tests/
specs/
input/
notes/
plan.md

